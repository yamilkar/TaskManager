{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Dynamo": {
    "TableName": "TaskManager-Users",
    "CreateTablesIfMissing": false
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Jwt": {
    "Issuer": "taskmanager-users",
    "Audience": "taskmanager-api"
  },
  "RateLimiting": {
    "LoginPermitLimit": 5
  },
  "Seed": {
    "Enabled": false
  }
}
